# Keycloak lab defaults — non-secret. Real secrets go in the gitignored .env.
# Override any value by exporting it before running labctl.sh.

: "${KEYCLOAK_IMAGE:=quay.io/keycloak/keycloak:26.2}"
: "${POSTGRES_IMAGE:=docker.io/library/postgres:16-alpine}"

# Keycloak binds to the VMware NAT host address so SIEM/SOAR VMs reach it
# as an external IdP; keep the products on 100.65.1.10 / 100.65.1.11.
: "${KEYCLOAK_HOST:=100.65.1.1}"
: "${KEYCLOAK_PORT:=8080}"

# Master realm admin (username only — password is a secret, see .env).
: "${KEYCLOAK_ADMIN:=admin}"

# Lab realm and SAML clients.
: "${REALM:=splunklab}"
: "${SIEM_ACS:=http://100.65.1.10:8000/saml/acs}"
: "${SOAR_ACS:=https://100.65.1.11:8443/saml2/callback/login}"
: "${SIEM_SP_ENTITY_ID:=http://100.65.1.10:8000}"
: "${SOAR_SP_ENTITY_ID:=https://100.65.1.11:8443}"

# SOAR VM for soar-configure.sh (SSH target).
: "${SOAR_HOST:=100.65.1.11}"
: "${SOAR_PORT:=8443}"

# Lab test user enrolled in TOTP via QR during first login.
: "${TEST_USER:=samluser}"
: "${TEST_USER_PASSWORD:=Splunk@2026}"

# Postgres database (names only — password is a secret, see .env).
: "${POSTGRES_DB:=keycloak}"
: "${POSTGRES_USER:=keycloak}"
