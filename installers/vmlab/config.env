# vmlab shared configuration — sourced by all scripts.
# Override any value by exporting it before running a script.

# --- Installer artifacts (live in installers/, gitignored) ---
: "${RHEL_ISO:=rhel-9.8-x86_64-dvd.iso}"
: "${SPLUNK_RPM:=splunk-10.4.2-33c3bf42cd73.x86_64.rpm}"
: "${SSE_TGZ:=splunk-security-essentials_383.tgz}"
: "${SOAR_TGZ:=splunk_soar-unpriv-8.6.0.530-9513a88f-el9-x86_64.tgz}"

# --- VMware Workstation ---
: "${VM_BASE_DIR:=$HOME/vmware}"          # where VM folders are created
: "${VM_GUEST_OS:=rhel9-64}"
: "${VM_HW_VERSION:=22}"                   # Workstation 17/26 -> 21/22
: "${SIEM_RAM:=4096}"
: "${SOAR_RAM:=6144}"
: "${SIEM_CPU:=4}"
: "${SOAR_CPU:=4}"

# --- VMware NAT network (vmnet8) ---
: "${NAT_GATEWAY:=100.65.1.2}"             # also the DNS forwarder
: "${NETMASK:=255.255.255.0}"
: "${SIEM_IP:=100.65.1.10}"
: "${SOAR_IP:=100.65.1.11}"
# Guest IPs are passed per-VM; keep them below the DHCP range (.128-.254).

# --- Locale ---
: "${TIMEZONE:=Asia/Ho_Chi_Minh}"
: "${SELINUX_MODE:=permissive}"            # lab default; 'enforcing' for hardening

# --- Lab credentials — real values go in gitignored config.local.env or env,
# never here. These placeholders only apply if nothing overrides them. ---
: "${LAB_PASSWORD:=changeme}"              # RHEL root + labadmin
: "${SPLUNK_ADMIN_PASSWORD:=$LAB_PASSWORD}"

# --- Stable SSH key reused across all lab VMs (outside the repo) ---
: "${LAB_SSH_KEY:=$VM_BASE_DIR/.vmlab_key}"

# --- Splunk Security Essentials sample events ---
: "${SSE_INDEX:=sse_lab}"
: "${SSE_DATA_DIR:=$VM_BASE_DIR/sse-data}"
: "${SSE_HEC_TOKEN_FILE:=$VM_BASE_DIR/.sse_hec_token}"
