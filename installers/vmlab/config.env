# vmlab shared configuration - sourced by all scripts.
# Override any value by exporting it before running a script.

# --- Installer artifacts (live in installers/, gitignored) ---
: "${RHEL_ISO:=rhel-9.8-x86_64-dvd.iso}"
: "${SPLUNK_RPM:=splunk-10.6.1.1-b2ae2962645c.x86_64.rpm}"
: "${SSE_TGZ:=splunk-security-essentials_383.tgz}"
: "${SOAR_TGZ:=splunk_soar-unpriv-8.8.0.282-81cb9deb-el9-x86_64.tgz}"

# Public downloads; SSE and RHEL require account downloads.
: "${SPLUNK_RPM_URL:=https://download.splunk.com/products/splunk/releases/10.6.1.1/linux/$SPLUNK_RPM}"
: "${SPLUNK_RPM_SHA512:=664e7f492887739e828552a9858f183e732f0c2e23e7a16a1f613888b3edf60ebb11776f7b32f7ac2bad1d00316be48b7211e8710dcb829e0ff95feadf8504ad}"
: "${SOAR_TGZ_URL:=https://download.splunk.com/products/splunk_soar-unpriv/releases/8.8.0/linux/$SOAR_TGZ}"
: "${SOAR_TGZ_SHA512:=0383dda3f15c7755d946cbeeed47433c00ff37967517cabd40b176f54a6f512406811ebd2bfba004a5a0fd2160d3fc839f63689ffd33db7aa5513372d4238491}"
: "${SSE_TGZ_SHA256:=f1b8d2d304ad651708cf9ac3c0dedd84eb6600af15520aa2ef67789f919b38ae}"
: "${RHEL_ISO_SHA256:=c0dd53b73406b85b40d6168d1748e605d71361b2992d282c408b7d7d2e1d2c80}"

# --- VMware Workstation ---
: "${VM_BASE_DIR:=$HOME/vmware}"          # where VM folders are created
: "${VM_GUEST_OS:=rhel9-64}"
: "${VM_HW_VERSION:=22}"                   # Workstation 17/26 -> 21/22
: "${SIEM_RAM:=4096}"
: "${SOAR_RAM:=8192}"
: "${SIEM_CPU:=4}"
: "${SOAR_CPU:=4}"

# --- VMware NAT network (vmnet8) ---
: "${NAT_GATEWAY:=100.65.1.2}"             # also the DNS forwarder
: "${NETMASK:=255.255.255.0}"
: "${SIEM_IP:=100.65.1.10}"
: "${SOAR_IP:=100.65.1.11}"
# Guest IPs are passed per-VM; keep them below the DHCP range (.128-.254).

# --- Locale ---
: "${TIMEZONE:=UTC}"
: "${SELINUX_MODE:=permissive}"            # lab default; 'enforcing' for hardening

# --- Lab credentials - real values go in gitignored config.local.env or env,
# never here. These placeholders only apply if nothing overrides them. ---
: "${LAB_PASSWORD:=changeme}"              # RHEL root + labadmin
: "${SPLUNK_ADMIN_PASSWORD:=$LAB_PASSWORD}"

# --- Stable SSH key reused across all lab VMs (outside the repo) ---
: "${LAB_SSH_KEY:=$VM_BASE_DIR/.vmlab_key}"

# --- Splunk Security Essentials sample events ---
: "${SSE_INDEX:=sse_lab}"
: "${SSE_DATA_DIR:=$VM_BASE_DIR/sse-data}"
: "${SSE_HEC_TOKEN_FILE:=$VM_BASE_DIR/.sse_hec_token}"
